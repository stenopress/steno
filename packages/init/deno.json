{
  "name": "@steno/init",
  "version": "0.11.2",
  "description": "Interactive scaffolder for new Steno static-site projects.",
  "exports": {
    ".": "./mod.ts",
    "./create": "./src/create.ts",
    "./create-theme": "./src/create_theme.ts",
    "./create-plugin": "./src/create_plugin.ts"
  },
  "publish": {
    "exclude": ["**/*_test.ts", "test.ts"]
  },
  "license": "MIT",
  "tasks": {
    "test": "deno test -A ./test.ts ./scaffold_test.ts",
    "test:smoke": "deno test -A ./smoke_test.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@1",
    "@std/path": "jsr:@std/path@1"
  }
}
