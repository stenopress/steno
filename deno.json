{
  "name": "@steno/steno",
  "version": "0.11.2",
  "description": "An ultra-lightweight, sub-millisecond static site generator powered by Deno.",
  "exports": "./mod.ts",
  "license": "MIT",
  "publish": {
    "exclude": [
      ".github",
      "docs",
      "test",
      "test.ts",
      "**/*_test.ts",
      "packages",
      "integration",
      "benchmarks",
      "api_compat"
    ]
  },
  "tasks": {
    "dev": "deno task --cwd test dev",
    "test": "deno task test:unit",
    "test:unit": "deno test -A ./test.ts ./src",
    "test:sites": "deno test -A ./integration/real_sites_test.ts",
    "test:ecosystem": "deno test -A ./integration/ecosystem_compat_test.ts",
    "test:all": "deno task test:unit && deno task test:sites",
    "bench": "deno bench -A ./benchmarks",
    "bench:check": "deno run -A ./benchmarks/perf_budget.ts",
    "bench:report": "deno run -A ./benchmarks/benchmark_report.ts",
    "bench:trends": "deno run -A ./benchmarks/bench_trends.ts",
    "doc:check": "deno doc --lint mod.ts",
    "check:api-compat": "deno check api_compat/theme.ts api_compat/plugin.ts api_compat/embedding.ts",
    "check": "deno fmt --check && deno lint && deno check mod.ts && deno task doc:check && deno task check:api-compat && deno task test:all"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/media-types": "jsr:@std/media-types@1.1.0",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/toml": "jsr:@std/toml@1.0.11",
    "@std/yaml": "jsr:@std/yaml@1.2.0",
    "@deno/emit": "jsr:@deno/emit@0.46.0",
    "marked": "npm:marked@18.0.7"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  }
}
